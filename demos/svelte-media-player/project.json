{
  "name": "svelte-media-player",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "demos/svelte-media-player/src",
  "tags": ["scope:demo", "type:demo-app"],
  "implicitDependencies": ["runtime-svelte", "web-components"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "demos/svelte-media-player"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/demos/svelte-media-player"],
      "options": {
        "command": "vite build",
        "cwd": "demos/svelte-media-player"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --port 4328",
        "cwd": "demos/svelte-media-player"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p demos/svelte-media-player/tsconfig.json"
      }
    }
  }
}
