{
  "name": "web-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/web-components/src",
  "projectType": "library",
  "tags": [
    "scope:runtime",
    "type:ui"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/web-components",
        "main": "packages/web-components/src/index.ts",
        "tsConfig": "packages/web-components/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/web-components",
            "glob": "README.md",
            "output": "."
          },
          {
            "input": "packages/web-components",
            "glob": "LICENSE",
            "output": "."
          },
          {
            "input": "packages/web-components/src",
            "glob": "**/*.css",
            "output": "."
          },
          {
            "input": "packages/web-components/src",
            "glob": "**/*.html",
            "output": "."
          }
        ],
        "additionalEntryPoints": [
          "packages/web-components/src/catalog/component-spec/index.ts",
          "packages/web-components/src/catalog/index.ts",
          "packages/web-components/src/domain/i18n/app-language-select/index.ts",
          "packages/web-components/src/domain/person-invite/index.ts",
          "packages/web-components/src/domain/role-assign/index.ts",
          "packages/web-components/src/domain/role-gate/index.ts",
          "packages/web-components/src/domain/time-preset/index.ts",
          "packages/web-components/src/layout/accordion-link-list/index.ts",
          "packages/web-components/src/layout/accordion/index.ts",
          "packages/web-components/src/layout/collapsible/index.ts",
          "packages/web-components/src/layout/flex/index.ts",
          "packages/web-components/src/layout/grid/index.ts",
          "packages/web-components/src/layout/modal/index.ts",
          "packages/web-components/src/layout/tabs/index.ts",
          "packages/web-components/src/logic/timer/index.ts",
          "packages/web-components/src/visual/chart/bar/index.ts",
          "packages/web-components/src/visual/chart/line/index.ts",
          "packages/web-components/src/visual/chart/pie/index.ts",
          "packages/web-components/src/visual/detail/index.ts",
          "packages/web-components/src/visual/display/3d-bar-chart/index.ts",
          "packages/web-components/src/visual/display/3d-geo-globe/index.ts",
          "packages/web-components/src/visual/display/3d-gltf-model/index.ts",
          "packages/web-components/src/visual/display/3d-scatter/index.ts",
          "packages/web-components/src/visual/display/3d-scene/index.ts",
          "packages/web-components/src/visual/display/geo-map/index.ts",
          "packages/web-components/src/visual/input/checkbox/index.ts",
          "packages/web-components/src/visual/input/date-range/index.ts",
          "packages/web-components/src/visual/input/number/index.ts",
          "packages/web-components/src/visual/input/select/index.ts",
          "packages/web-components/src/visual/input/text/index.ts",
          "packages/web-components/src/visual/input/textarea/index.ts",
          "packages/web-components/src/visual/kpi/index.ts",
          "packages/web-components/src/visual/link-list/index.ts",
          "packages/web-components/src/visual/media/equirect-viewport/index.ts",
          "packages/web-components/src/visual/media/index.ts",
          "packages/web-components/src/visual/media/live-capture/index.ts",
          "packages/web-components/src/visual/media/video-source/index.ts",
          "packages/web-components/src/visual/media/youtube-embed/index.ts",
          "packages/web-components/src/visual/news/article-detail/index.ts",
          "packages/web-components/src/visual/news/language-select/index.ts",
          "packages/web-components/src/visual/news/region-select/index.ts",
          "packages/web-components/src/visual/news/results-table/index.ts",
          "packages/web-components/src/visual/news/search-box/index.ts",
          "packages/web-components/src/visual/news/type-select/index.ts",
          "packages/web-components/src/visual/plugin/metric-chip/index.ts",
          "packages/web-components/src/visual/plugin/status-badge/index.ts",
          "packages/web-components/src/visual/skeleton/index.ts",
          "packages/web-components/src/visual/svg/icon/index.ts",
          "packages/web-components/src/visual/svg/inline/index.ts",
          "packages/web-components/src/visual/table/index.ts",
          "packages/web-components/src/visual/wasm/media/index.ts",
          "packages/web-components/src/visual/wasm/module/index.ts",
          "packages/web-components/src/visual/wasm/worker-host/index.ts",
          "packages/web-components/src/wasm/index.ts",
          "packages/web-components/src/wasm/wasm-media/index.ts"
        ],
        "generateExportsField": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/web-components/tsconfig.lib.json"
      }
    }
  }
}
