# RosettaDash — environment variable reference
#
# Copy to `.env.local` (gitignored) and uncomment values you need.
# Never commit real secrets.
#
# Where files live:
#   • Builder + NestJS API (`apps/server`) — variables in this repo root `.env.local`
#   • Vite proof apps (Destination Atlas) — copy the VITE_* section to
#     `apps/proof-react/.env.local` (see also `apps/proof-react/.env.example`)
#
# Builder BYOK (DAS-70): AI keys can be stored in the browser Environment page
# instead of env files. Destination Atlas consumer BYOK (DAS-135): Settings →
# Integration keys. Build-time `VITE_*` vars remain useful for local dev fallbacks.
#
# Catalog source of truth: `@rosettadash/core/lib/byok`
#   • environment-catalog.ts — builder, database, server, AI
#   • integration-catalog.ts — maps, tiles, news
#   • provider-manifest.ts — AI provider IDs and models


# =============================================================================
# RosettaDash builder API (apps/server)
# =============================================================================

# Optional shared API auth for deployed / multi-user installs (default: off locally)
BUILDER_AUTH_ENABLED=false
# JIRA_API_KEY=
# Server-side secret when BUILDER_AUTH_ENABLED=true (NestJS builder-auth.guard)
# BUILDER_API_KEY=change-me-shared-builder-secret

# HTTP bind (apps/server/src/main.ts)
PORT=3000
HOST=0.0.0.0

# Browser → API shared key (Environment page / ROSETTADASH_API_KEY — client BYOK vault)
# Used when builder auth is enabled; not the app-lock password.
# ROSETTADASH_API_KEY=


# =============================================================================
# AI providers (BYOK) — builder AI assist & future AI components
# =============================================================================
# Configure in builder: Environment → AI providers, or set here for CI/scripts.
# Default local provider: Ollama (no key). Cloud providers are bring-your-own-key.

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Google Gemini (Google AI Studio) ---
# GOOGLE_AI_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_DEPLOYMENT_ID=
# AZURE_OPENAI_BASE_URL=

# --- Ollama (local, free — recommended for dev) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=


# =============================================================================
# Destination Atlas / geo & media integrations (consumer apps)
# =============================================================================
# Canonical keys (Stack infra, export wizards). Vite proof apps expose these via
# VITE_* in apps/proof-react/.env.local — see apps/proof-react/.env.example.

# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_KEY=

# MAPTILER_API_KEY=

# NEWS_API_KEY=

# Optional feature toggles (Stack demo / exported apps)
# FEATURE_FLAGS=


# =============================================================================
# Database (exported stack / infra nodes — enable for your stack profile)
# =============================================================================

# DATABASE_URL=postgresql://user:pass@localhost:5432/rosettadash
# MONGODB_URI=mongodb://localhost:27017/rosettadash
# MYSQL_URL=mysql://user:pass@localhost:3306/rosettadash
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=


# =============================================================================
# Server export stubs (Nest, Express, Next, Nuxt)
# =============================================================================

# API_PREFIX=api
# JWT_SECRET=change-me-in-production
# CORS_ORIGIN=http://localhost:4200
