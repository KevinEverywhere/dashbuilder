{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../web-components/src/types/ffmpeg.d.ts",
    "../web-components/src/types/vite-raw.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "jest.config.cts"
  ]
}
