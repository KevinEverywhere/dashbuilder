{
  "name": "angular-poll-tracker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "demos/angular-poll-tracker/src",
  "tags": ["scope:demo", "type:demo-app"],
  "implicitDependencies": ["runtime-angular", "web-components"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "demos/angular-poll-tracker"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/demos/angular-poll-tracker"],
      "options": {
        "command": "vite build",
        "cwd": "demos/angular-poll-tracker"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --port 4325",
        "cwd": "demos/angular-poll-tracker"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p demos/angular-poll-tracker/tsconfig.json"
      }
    }
  }
}
