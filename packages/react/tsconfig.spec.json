{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "lib": ["es2020", "dom"]
  },
  "include": [
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../web-components/src/types/ffmpeg.d.ts",
    "../web-components/src/types/vite-raw.d.ts"
  ]
}
