{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "importHelpers": true
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
