{
  "name": "rosettadash",
  "version": "0.1.2",
  "description": "RosettaDash product monorepo — visual dashboard builder plus five Storybook component catalogs. Not a component library; install @rosettadash/web-components for UI elements.",
  "author": "Kevin Ready <kevin@planetkevin.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinEverywhere/rosettadash.git"
  },
  "homepage": "https://github.com/KevinEverywhere/rosettadash#readme",
  "bugs": {
    "url": "https://github.com/KevinEverywhere/rosettadash/issues"
  },
  "main": "index.js",
  "scripts": {
    "sync:readme": "cp README.md apps/client/public/readme.md",
    "prestart:client": "npm run sync:readme",
    "start:client": "nx serve client",
    "start:server": "nx serve server",
    "start": "nx run-many -t serve -p client,server --parallel=2",
    "build": "nx run-many -t build -p client,server,core,web-components,runtime-react,runtime-angular,runtime-vue,runtime-svelte",
    "test": "nx run-many -t test -p client,server,core,ui-primitives,web-components,runtime-react,runtime-angular,runtime-vue,runtime-svelte,exporters-react,exporters-nest,exporters-angular,exporters-vue,exporters-express,exporters-next,exporters-nuxt,exporters-svelte,exporters-web-components,exporters-mongodb,exporters-mysql,exporters-supabase",
    "lint": "nx run-many -t lint -p client,server,core,ui-primitives,web-components,runtime-react,runtime-angular,runtime-vue,runtime-svelte,exporters-react,exporters-nest,exporters-angular,exporters-vue,exporters-express,exporters-next,exporters-nuxt,exporters-svelte,exporters-web-components,exporters-mongodb,exporters-mysql,exporters-supabase",
    "typecheck": "nx run-many -t typecheck -p client,server,core,ui-primitives,web-components,runtime-react,runtime-angular,runtime-vue,runtime-svelte,exporters-react,exporters-nest,exporters-angular,exporters-vue,exporters-express,exporters-next,exporters-nuxt,exporters-svelte,exporters-web-components,exporters-mongodb,exporters-mysql,exporters-supabase",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "pack:core": "nx build core && npm pack ./dist/packages/core --dry-run",
    "pack:web-components": "nx build web-components && node scripts/bundle-browser-media.mjs && npm pack ./dist/packages/web-components --dry-run",
    "pack:runtimes": "nx run-many -t build -p runtime-react,runtime-angular,runtime-vue,runtime-svelte && npm pack ./dist/packages/react --dry-run && npm pack ./dist/packages/angular --dry-run && npm pack ./dist/packages/vue --dry-run && npm pack ./dist/packages/svelte --dry-run",
    "pack:consumer": "nx run-many -t build -p core,web-components,runtime-react,runtime-angular,runtime-vue,runtime-svelte && node scripts/bundle-browser-media.mjs && npm pack ./dist/packages/core && npm pack ./dist/packages/web-components && npm pack ./dist/packages/react && npm pack ./dist/packages/angular && npm pack ./dist/packages/vue && npm pack ./dist/packages/svelte",
    "generate:react-runtime": "node scripts/generate-react-runtime.mjs --write",
    "generate:angular-runtime": "node scripts/generate-angular-runtime.mjs --write",
    "generate:vue-runtime": "node scripts/generate-vue-runtime.mjs --write",
    "generate:svelte-runtime": "node scripts/generate-svelte-runtime.mjs --write",
    "publish:npm": "npm run pack:consumer && npm publish ./dist/packages/core --access public && npm publish ./dist/packages/web-components --access public && npm publish ./dist/packages/react --access public && npm publish ./dist/packages/angular --access public && npm publish ./dist/packages/vue --access public && npm publish ./dist/packages/svelte --access public",
    "setup:e2e": "playwright install chromium",
    "e2e:prep": "node scripts/check-e2e-ports.mjs",
    "e2e": "npm run e2e:prep && nx e2e client-e2e",
    "e2e:fresh": "npm run e2e:prep && nx e2e client-e2e --skip-nx-cache",
    "verify:all": "npm run verify && npm run e2e",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:dev:down": "docker compose --profile dev down",
    "docker:app": "docker compose --profile app up --build",
    "docker:app:down": "docker compose --profile app down",
    "storybook:clean-cache": "rm -rf node_modules/.cache/storybook",
    "storybook:web-components": "nx storybook storybook-web-components",
    "storybook:react": "nx storybook storybook-react",
    "storybook:vue": "nx storybook storybook-vue",
    "storybook:angular": "nx storybook storybook-angular",
    "storybook:svelte": "nx storybook storybook-svelte",
    "storybook:all": "nx run-many -t storybook -p storybook-web-components,storybook-react,storybook-vue,storybook-angular,storybook-svelte --parallel=5",
    "build-storybook": "nx run-many -t build-storybook -p storybook-web-components,storybook-react,storybook-vue,storybook-angular,storybook-svelte",
    "proof:web-components": "nx serve proof-web-components",
    "proof:web-components:build": "nx build proof-web-components",
    "proof:react": "nx serve proof-react",
    "proof:react:build": "nx build proof-react",
    "proof:angular": "nx serve proof-angular",
    "proof:angular:build": "nx build proof-angular",
    "proof:vue": "nx serve proof-vue",
    "proof:vue:build": "nx build proof-vue",
    "proof:svelte": "nx serve proof-svelte",
    "proof:svelte:build": "nx build proof-svelte"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@angular-devkit/core": "~22.0.4",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/build": "~22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/compiler-cli": "~22.0.4",
    "@angular/language-service": "~22.0.4",
    "@babel/standalone": "^8.0.4",
    "@eslint/js": "^9.8.0",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "^23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/node": "23.1.1",
    "@nx/playwright": "^23.1.1",
    "@nx/storybook": "^23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.0.4",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/angular-vite": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@storybook/svelte-vite": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@storybook/web-components-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/jest": "~30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.172.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.11",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.3.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "storybook": "^10.5.7",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@angular/common": "~22.0.4",
    "@angular/compiler": "~22.0.4",
    "@angular/core": "~22.0.4",
    "@angular/forms": "~22.0.4",
    "@angular/platform-browser": "~22.0.4",
    "@angular/router": "~22.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "svelte": "^5.56.8",
    "three": "^0.172.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "nx": {}
}
