{
  "name": "proof-svelte",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/proof-svelte/src",
  "tags": ["scope:destination-atlas", "type:proof-app"],
  "implicitDependencies": [
    "runtime-svelte",
    "runtime-vue",
    "runtime-angular",
    "web-components",
    "destination-atlas"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/proof-svelte"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/proof-svelte"],
      "options": {
        "command": "vite build",
        "cwd": "apps/proof-svelte"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --port 4314",
        "cwd": "apps/proof-svelte"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/proof-svelte/tsconfig.json"
      }
    }
  }
}
