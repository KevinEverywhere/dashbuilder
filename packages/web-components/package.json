{
  "name": "@rosettadash/web-components",
  "version": "0.1.2",
  "description": "RosettaDash Web Components runtime — typed custom elements with optional tokens.css / styles.css. Storybook catalog: clone github.com/KevinEverywhere/rosettadash (port 6006).",
  "author": "Kevin Ready <kevin@planetkevin.com>",
  "type": "module",
  "license": "MIT",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./layout/accordion": {
      "types": "./src/layout/accordion/index.d.ts",
      "import": "./src/layout/accordion/index.js",
      "default": "./src/layout/accordion/index.js"
    },
    "./layout/accordion-link-list": {
      "types": "./src/layout/accordion-link-list/index.d.ts",
      "import": "./src/layout/accordion-link-list/index.js",
      "default": "./src/layout/accordion-link-list/index.js"
    },
    "./visual/link-list": {
      "types": "./src/visual/link-list/index.d.ts",
      "import": "./src/visual/link-list/index.js",
      "default": "./src/visual/link-list/index.js"
    },
    "./media": {
      "types": "./src/visual/media/index.d.ts",
      "import": "./src/visual/media/index.js",
      "default": "./src/visual/media/index.js"
    },
    "./wasm": {
      "types": "./src/wasm/index.d.ts",
      "import": "./src/wasm/index.js",
      "default": "./src/wasm/index.js"
    },
    "./catalog": {
      "types": "./src/catalog/index.d.ts",
      "import": "./src/catalog/index.js",
      "default": "./src/catalog/index.js"
    },
    "./catalog/palette-catalog": {
      "types": "./src/catalog/index.d.ts",
      "import": "./src/catalog/index.js",
      "default": "./src/catalog/index.js"
    },
    "./catalog/component-spec": {
      "types": "./src/catalog/component-spec/index.d.ts",
      "import": "./src/catalog/component-spec/index.js",
      "default": "./src/catalog/component-spec/index.js"
    },
    "./visual/media/video-source": {
      "types": "./src/visual/media/video-source/index.d.ts",
      "import": "./src/visual/media/video-source/index.js",
      "default": "./src/visual/media/video-source/index.js"
    },
    "./visual/media/equirect-viewport": {
      "types": "./src/visual/media/equirect-viewport/index.d.ts",
      "import": "./src/visual/media/equirect-viewport/index.js",
      "default": "./src/visual/media/equirect-viewport/index.js"
    },
    "./visual/media/youtube-embed": {
      "types": "./src/visual/media/youtube-embed/index.d.ts",
      "import": "./src/visual/media/youtube-embed/index.js",
      "default": "./src/visual/media/youtube-embed/index.js"
    },
    "./domain/i18n/app-language-select": {
      "types": "./src/domain/i18n/app-language-select/index.d.ts",
      "import": "./src/domain/i18n/app-language-select/index.js",
      "default": "./src/domain/i18n/app-language-select/index.js"
    },
    "./visual/display/geo-map": {
      "types": "./src/visual/display/geo-map/index.d.ts",
      "import": "./src/visual/display/geo-map/index.js",
      "default": "./src/visual/display/geo-map/index.js"
    },
    "./visual/wasm/media": {
      "types": "./src/visual/wasm/media/index.d.ts",
      "import": "./src/visual/wasm/media/index.js",
      "default": "./src/visual/wasm/media/index.js"
    },
    "./browser/media": {
      "import": "./browser/media.js",
      "default": "./browser/media.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./styles.css": "./styles/styles.css"
  },
  "files": [
    "src",
    "styles",
    "media",
    "browser",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@ffmpeg/ffmpeg": ">=0.12.0",
    "@ffmpeg/util": ">=0.12.0",
    "@googlemaps/js-api-loader": ">=1.16.0",
    "leaflet": ">=1.9.0",
    "maplibre-gl": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@ffmpeg/ffmpeg": {
      "optional": true
    },
    "@ffmpeg/util": {
      "optional": true
    },
    "@googlemaps/js-api-loader": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@rosettadash/core": "0.1.1",
    "tslib": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinEverywhere/rosettadash.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/KevinEverywhere/rosettadash#component-examples-storybook",
  "bugs": {
    "url": "https://github.com/KevinEverywhere/rosettadash/issues"
  }
}
