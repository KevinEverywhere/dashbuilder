# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Local secrets (Jira API keys, etc.) — never commit real credentials
.env
.env.local
.env.*.local

# npm pack artifacts (DAS-99 consumer tarballs)
*.tgz

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

__screenshots__/

# Python tool venvs (VLC viewpoint dump, etc.)
tools/.venv-vlc/

# Local test media and scratch files (authoring experiments, ffmpeg output)
.local/

# Agent / workflow scratch (Jira REST payloads, one-off JSON — never commit)
.scratch/

# Backend parity server apps — regenerated from the exporters on demand
# (npm run parity:generate). The seed scripts in docker/seed/ ARE committed.
.parity/

# Generated Authoring 360 public links (npm run authoring:link-360 / postinstall)
apps/proof-*/public/authoring-360/
demos/ce-360-tour-player/public/authoring-360/

# Playwright (local e2e artifacts — see dist/.playwright when outputDir is under dist)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
